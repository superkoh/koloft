ARG BASE=ubuntu:22.04
FROM ${BASE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tmux python3 ncurses-term procps util-linux ca-certificates && useradd -m -s /bin/bash u && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /home/u/.local/share && chown -R u:u /home/u/.local
COPY --chown=u:u musebin /home/u/.local/bin
COPY kit /kit
COPY drive.py /kit/drive.py
USER u
WORKDIR /home/u
CMD ["sleep", "infinity"]
