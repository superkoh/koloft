{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite/client supplies the `*.css` (and other asset) module declarations that
    // TS 7 now demands for side-effect imports — see main.tsx.
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@agents/*": ["./src/agents/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/plugins/**/*",
    "src/agents/**/*"
  ],
  "exclude": [
    "src/plugins/*/main/**",
    "src/plugins/starts.ts",
    "src/agents/*/main/**",
    "src/agents/starts.ts"
  ]
}
