{
  "manifest_version": 3,
  "name": "Koloft BB Storage RW",
  "version": "1.0.0",
  "description": "Black-box probe: writes on #write, reads back into an attribute on #read.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Koloft BB Storage RW"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["probe.js"]
    }
  ]
}
