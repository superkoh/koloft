{
  "allowedMcpServers": [],
  "skillOverrides": {
    "playwright-cli": "on"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "asyncRewake": true,
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/worktree-deps.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-comments.mjs\" --hook"
          }
        ]
      }
    ]
  }
}
